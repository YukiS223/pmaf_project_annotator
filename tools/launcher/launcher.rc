#include <winver.h>

/* Application manifest (RT_MANIFEST, id 1) */
1 24 "launcher.manifest"

/* Icon (id 1 = the one Explorer shows) */
1 ICON "pmaf.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     2,0,0,0
 PRODUCTVERSION  2,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "PMAF Annotator project"
      VALUE "FileDescription",  "PMAF Annotator (local aurora annotation tool)"
      VALUE "FileVersion",      "2.0.0.0"
      VALUE "InternalName",     "START_HERE"
      VALUE "OriginalFilename", "START_HERE.exe"
      VALUE "ProductName",      "PMAF Annotator"
      VALUE "ProductVersion",   "2.0.0"
      VALUE "LegalCopyright",   "Internal research tool. Runs locally only; no network access."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
